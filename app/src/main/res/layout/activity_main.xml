<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1016"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnHistory"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:contentDescription="Histórico de conversas"
            android:text="☰"
            android:textColor="#EBEFF5"
            android:textSize="25sp"
            android:fontFamily="sans" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AXIOM"
                android:fontFamily="sans"
                android:textStyle="bold"
                android:textColor="#F3F5F8"
                android:textSize="19sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assistente local"
                android:fontFamily="sans"
                android:textColor="#A1A9B6"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/btnNew"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:contentDescription="Nova conversa"
            android:text="＋"
            android:fontFamily="sans"
            android:textColor="#F3F5F8"
            android:textSize="29sp"/>
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:contentDescription="Configurações de modelo"
            android:text="⚙"
            android:fontFamily="sans"
            android:textColor="#AAB7C6"
            android:textSize="24sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:text="Inicializando…"
        android:textColor="#80C6CA"
        android:background="#171E26"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingEnd="12dp"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/modelPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C2533"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:text="Modelo local"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:text="Baixe o Qwen2.5 0.5B (~398 MB) uma vez ou importe um GGUF. Depois, a IA funciona sem conexão."
            android:textColor="#BDCCE2"
            android:paddingTop="5dp"
            android:paddingBottom="6dp"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Baixar IA"
                android:fontFamily="sans"
                android:textAllCaps="false"
                android:backgroundTint="#42C9BC"
                android:textColor="#0D1016" />
            <Button
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="sans"
                android:text="Importar GGUF"
                android:textAllCaps="false"
                android:backgroundTint="#3F5175"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progressModel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="14dp"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E232B"
        android:padding="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/inputPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:maxLines="5"
            android:hint="Mensagem para AXIOM"
            android:fontFamily="sans"
            android:inputType="textCapSentences|textMultiLine"
            android:background="@android:color/transparent"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="#F4F5F6"
            android:textColorHint="#A1A8B3"
            android:textSize="15sp"/>
        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="↑"
            android:fontFamily="sans"
            android:contentDescription="Enviar mensagem"
            android:enabled="false"
            android:textSize="22sp"
            android:minWidth="48dp"
            android:textAllCaps="false"
            android:backgroundTint="#42C9BC"
            android:textColor="#0D1016"/>
        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="■"
            android:fontFamily="sans"
            android:minWidth="48dp"
            android:contentDescription="Interromper resposta"
            android:visibility="gone"
            android:textAllCaps="false"
            android:backgroundTint="#EBC06F"
            android:textColor="#0D1016"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Respostas podem conter erros · Conversas salvas no aparelho"
        android:textColor="#828A97"
        android:fontFamily="sans"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="10sp"/>
</LinearLayout>
