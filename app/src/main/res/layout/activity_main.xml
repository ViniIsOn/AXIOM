<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080E20"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="AXIOM"
            android:src="@drawable/ic_axiom" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AXIOM"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="23sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA local • sem mensalidade"
                android:textColor="#91A7C9"
                android:textSize="11sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modelo"
            android:textAllCaps="false"
            android:textColor="#03141A"
            android:backgroundTint="#31D9E8" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparando a AXIOM…"
        android:textColor="#A9BDD7"
        android:textSize="12sp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/modelPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#142440"
        android:padding="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cérebro da AXIOM"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Baixe o Qwen2.5 0.5B (~398 MB) uma vez. Depois, converse offline. Recomendo Wi-Fi e ao menos 1 GB livre. Também pode importar outro GGUF compatível."
            android:textColor="#BDCCE2"
            android:paddingTop="5dp"
            android:paddingBottom="6dp"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Baixar IA"
                android:textAllCaps="false"
                android:backgroundTint="#31D9E8"
                android:textColor="#081125" />
            <Button
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Importar GGUF"
                android:textAllCaps="false"
                android:backgroundTint="#3F5175"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progressModel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/inputPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="4"
            android:minHeight="50dp"
            android:hint="Pergunte à AXIOM..."
            android:inputType="textCapSentences|textMultiLine"
            android:backgroundTint="#31D9E8"
            android:textColor="#FFFFFF"
            android:textColorHint="#788EAD"
            android:textSize="15sp"/>
        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Enviar"
            android:enabled="false"
            android:textAllCaps="false"
            android:backgroundTint="#31D9E8"
            android:textColor="#061425"/>
        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Parar"
            android:visibility="gone"
            android:textAllCaps="false"
            android:backgroundTint="#F0BA66"
            android:textColor="#061425"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limpar conversa"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:textColor="#95A6C7"
        android:textSize="12sp"/>
</LinearLayout>
